# ──────────────────────────────────────────────────────────────────────────────
# AI TravelMate – Environment Variables
# Copy this file to .env and fill in your real API keys.
#
#   cp .env.example .env
#
# NEVER commit the .env file to version control.
# ──────────────────────────────────────────────────────────────────────────────

# Google Gemini API Key
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# SerpAPI Key (for real-time Google Flights data)
# Get yours at: https://serpapi.com/manage-api-key
# If left empty, the app will use mock flight data for demonstration.
SERPAPI_KEY=your_serpapi_key_here
